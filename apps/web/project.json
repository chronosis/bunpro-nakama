{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web",
  "projectType": "application",
  "tags": ["type:app"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vue-tsc --noEmit -p .nuxt/tsconfig.app.json && pnpm exec vue-tsc --noEmit -p .nuxt/tsconfig.server.json",
        "cwd": "apps/web"
      }
    }
  }
}
