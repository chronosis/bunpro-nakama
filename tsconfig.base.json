{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "target": "es2022",
    "baseUrl": ".",
    "customConditions": ["@bunpro-nakama/source"],
    "paths": {
      "@bunpro-nakama/session-history": [
        "libs/session-history/src/index.ts"
      ]
    }
  }
}
